---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tr('meta.title')}</title>
    <meta name="description" content={tr('meta.description')} />
    <meta name="theme-color" content="#fbfbfd" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`${site}${lang === 'hu' ? '/' : '/en/'}`} />
    <link rel="alternate" hreflang="hu" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <meta property="og:title" content={tr('meta.title')} />
    <meta property="og:description" content={tr('meta.description')} />
    <meta property="og:type" content="website" />
    <!-- a görgetéses animációk csak akkor rejtik el az elemeket, ha fut a JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>

    <script>
      // Előúszás: amikor egy .reveal elem a képernyőre ér, megkapja az .in osztályt.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
