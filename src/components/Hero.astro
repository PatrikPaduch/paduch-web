---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section class="hero">
  <div class="glow" aria-hidden="true">
    <span class="g1"></span><span class="g2"></span><span class="g3"></span>
  </div>

  <div class="hero-inner wrap">
    <p class="eyebrow hero-eyebrow">{tr('hero.eyebrow')}</p>
    <h1 class="hero-title">
      <span class="line l1">{tr('hero.title1')}</span>
      <span class="line l2">{tr('hero.title2')}</span>
      <span class="line l3 gradient-text">{tr('hero.title3')}</span>
    </h1>
    <p class="lead hero-lead">{tr('hero.lead')}</p>
    <a class="pill hero-cta" href="#projects">
      {tr('hero.cta')}
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"
        ><path d="M6 1v10M1.5 6.5 6 11l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6"
        ></path></svg
      >
    </a>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span>{tr('hero.scroll')}</span>
    <i></i>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 52px);
    display: grid;
    place-items: center;
    overflow: hidden;
    text-align: center;
    padding: 96px 0 120px;
  }

  /* lassan mozgó színes fényfoltok a háttérben */
  /* radial-gradient + transform: a GPU-nak olcsó (nincs filter: blur) */
  .glow {
    position: absolute;
    inset: -20%;
    opacity: 0.7;
    pointer-events: none;
  }
  .glow span {
    position: absolute;
    width: 60vmax;
    height: 60vmax;
    border-radius: 50%;
    will-change: transform;
    animation: float 18s ease-in-out infinite alternate;
  }
  .g1 {
    background: radial-gradient(closest-side, #9cc9ff, transparent);
    left: 0;
    top: 0;
  }
  .g2 {
    background: radial-gradient(closest-side, #d9c9ff, transparent);
    right: 0;
    top: 10%;
    animation-delay: -6s !important;
  }
  .g3 {
    background: radial-gradient(closest-side, #ffd0dd, transparent);
    left: 30%;
    bottom: -10%;
    animation-delay: -12s !important;
  }
  @keyframes float {
    to {
      transform: translate3d(8vmax, -6vmax, 0) scale(1.15);
    }
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 21px;
    color: var(--ink);
    margin-bottom: 18px;
  }

  .hero-title {
    font-size: clamp(44px, 10.5vw, 136px);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .line {
    display: block;
    animation: rise 1.4s var(--ease) both;
  }
  .l2 {
    animation-delay: 0.12s;
  }
  .l3 {
    animation-delay: 0.24s;
    padding-bottom: 0.06em;
  }

  .hero-lead {
    max-width: 640px;
    margin-top: 32px;
    animation: rise 1.4s var(--ease) 0.4s both;
  }

  .hero-cta {
    margin-top: 36px;
    animation: rise 1.4s var(--ease) 0.55s both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(8px);
    }
  }

  .scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--ink-2);
    animation: rise 1.4s var(--ease) 1s both;
  }
  .scroll-hint i {
    width: 1px;
    height: 36px;
    background: linear-gradient(var(--ink-2), transparent);
    animation: drip 2.2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* görgetéskor a hero lassan elhalványul és összemegy (ahol a böngésző tudja) */
  @supports (animation-timeline: scroll()) {
    .hero-inner {
      animation: hero-out linear both;
      animation-timeline: scroll(root);
      animation-range: 0 80vh;
    }
    /* csak opacity + transform: ezt a videokártya rajzolja, nem a processzor */
    @keyframes hero-out {
      to {
        opacity: 0;
        transform: scale(0.92) translateY(-60px);
      }
    }
  }
</style>
