---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const tiles = [
  {
    key: 'net',
    icon: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5v4M12 11.5 6.5 17M12 11.5l5.5 5.5"/>',
    hue: '#2997ff',
  },
  {
    key: 'mon',
    icon: '<path d="M3 12h4l2.5-6 5 12L17 12h4"/>',
    hue: '#30d158',
  },
  {
    key: 'auto',
    icon: '<path d="m8 8-5 4 5 4M16 8l5 4-5 4M13.5 5l-3 14"/>',
    hue: '#bf5af2',
  },
  {
    key: 'web',
    icon: '<path d="M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 8.5a4.25 4.25 0 0 1-.25 9.5z"/>',
    hue: '#ff9f0a',
  },
] as const;
---

<section id="work" class="work">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow reveal">{tr('work.eyebrow')}</p>
      <h2 class="headline reveal" style="--d:.08s">{tr('work.title')}</h2>
      <p class="lead reveal" style="--d:.16s">{tr('work.lead')}</p>
    </header>

    <div class="grid">
      {
        tiles.map((tile, i) => (
          <article class="tile reveal" style={`--d:${i * 0.08}s; --hue:${tile.hue}`}>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" set:html={tile.icon} />
            <h3>{tr(`work.${tile.key}.title`)}</h3>
            <p>{tr(`work.${tile.key}.text`)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding: clamp(96px, 14vw, 180px) 0;
    background: var(--bg-alt);
  }
  .head {
    max-width: 760px;
    margin-bottom: 64px;
  }
  .head .headline {
    margin: 12px 0 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .tile {
    position: relative;
    overflow: hidden;
    background: #fff;
    border-radius: var(--radius);
    padding: 40px;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease),
      opacity 1.1s var(--ease);
  }
  .tile::before {
    content: '';
    position: absolute;
    right: -30%;
    top: -40%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--hue), transparent);
    opacity: 0.16;
    transition: opacity 0.6s var(--ease);
  }
  .tile:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.18);
  }
  .tile:hover::before {
    opacity: 0.3;
  }
  .icon {
    width: 44px;
    height: 44px;
    margin-bottom: auto;
    fill: none;
    stroke: var(--hue);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tile h3 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 48px 0 10px;
  }
  .tile p {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 380px;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tile {
      padding: 32px;
      min-height: 220px;
    }
  }
</style>
